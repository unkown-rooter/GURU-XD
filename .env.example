# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Multi-Provider Enterprise AI Configuration
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
GITHUB_MODELS_TOKEN=""
OLLAMA_URL=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
XAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Real-World Database Connection Credentials
# MONGODB_URI: Connection string for the production MongoDB cluster database.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/production?retryWrites=true&w=majority"

# Security & Admin Access Credentials
# ADMIN_API_KEY: Secret key used to authorize API actions in production hosting.
ADMIN_API_KEY="gr-live_9438275983759843279584379258943"

# External Notification Webhooks
# DISCORD_WEBHOOK_URL: URL to relay cluster failures and status triggers to Discord/Slack.
DISCORD_WEBHOOK_URL=""

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
